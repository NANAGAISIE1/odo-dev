<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_review_listing_tree" model="ir.ui.view">
        <field name="name">review.listing.list</field>
        <field name="model">review.listing</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="listing_type" />
                <field name="platform" />
                <field name="review_count" />
                <field name="avg_rating" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_review_listing_form" model="ir.ui.view">
        <field name="name">review.listing.form</field>
        <field name="model">review.listing</field>
        <field name="arch" type="xml">
            <form string="Listing">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="listing_type" />
                            <field name="platform" />
                            <field name="external_ref" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="review_count" readonly="1" />
                            <field name="avg_rating" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Reviews">
                            <field name="review_ids" context="{'default_listing_id': active_id}">
                                <list editable="bottom">
                                    <field name="sequence" />
                                    <field name="author_name" />
                                    <field name="rating" />
                                    <field name="date" />
                                    <field name="state" />
                                    <field name="sentiment" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </chatter>
            </form>
        </field>
    </record>
</odoo>