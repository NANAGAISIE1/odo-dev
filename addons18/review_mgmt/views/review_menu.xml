<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_review_root" name="Reviews" sequence="10" />

    <menuitem id="menu_review_listings" name="Listings" parent="review_mgmt.menu_review_root"
        sequence="10" groups="review_mgmt.group_review_user" />
    <menuitem id="menu_review_reviews" name="Reviews" parent="review_mgmt.menu_review_root"
        sequence="20" groups="review_mgmt.group_review_user" />
    <menuitem id="menu_review_settings" name="Configuration" parent="review_mgmt.menu_review_root"
        sequence="90" groups="review_mgmt.group_review_manager" />

    <record id="action_review_listing" model="ir.actions.act_window">
        <field name="name">Listings</field>
        <field name="res_model">review.listing</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <menuitem id="menu_action_review_listing" parent="review_mgmt.menu_review_listings"
        action="review_mgmt.action_review_listing" />

    <record id="action_review_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">review.review</field>
        <field name="view_mode">list,form,kanban,graph,pivot</field>
    </record>
    <menuitem id="menu_action_review_review" parent="review_mgmt.menu_review_reviews"
        action="review_mgmt.action_review_review" />

    <record id="action_review_response_template" model="ir.actions.act_window">
        <field name="name">Response Templates</field>
        <field name="res_model">review.response.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_action_review_response_template" parent="review_mgmt.menu_review_settings"
        action="review_mgmt.action_review_response_template" />
</odoo>